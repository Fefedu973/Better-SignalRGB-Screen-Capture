<UserControl
    x:Class="Better_SignalRGB_Screen_Capture.Views.DraggableSourceItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Better_SignalRGB_Screen_Capture.Converters"
    MinWidth="1"
    MinHeight="1"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringToIconConverter x:Key="StringToIconConverter" />
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="RotateTransform" />
        </Grid.RenderTransform>


        <Grid x:Name="MediaContainer" IsHitTestVisible="False" Opacity="{x:Bind Source.Opacity, Mode=OneWay}">
        <!-- Border without flip transform - provides background and styling -->
        <Border
            x:Name="ItemBorder" IsHitTestVisible="False"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}" />

        <!-- Live preview frame (mirrors the same flip transforms applied to content) -->
        <Border x:Name="PreviewBorder"
                CornerRadius="{StaticResource ControlCornerRadius}"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5"
                Visibility="{x:Bind Source.IsLivePreviewEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="{x:Bind Source.IsMirroredHorizontally, Converter={StaticResource BooleanToScaleConverter}, Mode=OneWay}"
                               ScaleY="{x:Bind Source.IsMirroredVertically, Converter={StaticResource BooleanToScaleConverter}, Mode=OneWay}"/>
            </Border.RenderTransform>
            <Image x:Name="PreviewImage"
                   Stretch="Fill" />
        </Border>

        <!-- Content container with flip transform -->
        <Border
            x:Name="ContentBorder" IsHitTestVisible="False"
            CornerRadius="{StaticResource ControlCornerRadius}"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="{x:Bind Source.IsMirroredHorizontally, Converter={StaticResource BooleanToScaleConverter}, Mode=OneWay}" ScaleY="{x:Bind Source.IsMirroredVertically, Converter={StaticResource BooleanToScaleConverter}, Mode=OneWay}" />
            </Border.RenderTransform>
            <Grid Padding="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="DisplayNameText"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Source Name"
                    TextTrimming="CharacterEllipsis" />
                <FontIcon
                    x:Name="TypeIcon"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Source.Type, Mode=OneWay, Converter={StaticResource StringToIconConverter}}" />
            </Grid>
        </Border>

        </Grid>
        <!-- Crop shading overlay - NOT affected by flip transform -->
        <Path x:Name="CropShadePath" IsHitTestVisible="False"
              Fill="Black"
              Opacity="0.35"/>

        <!-- Only the visible polygon participates in source hit testing. -->
        <Path x:Name="VisibleHitSurface" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Canvas x:Name="RotationHandleCanvas" Visibility="Collapsed">
            <Border x:Name="HoverBorder" IsHitTestVisible="False"
                    BorderBrush="{ThemeResource SystemAccentColorLight2}" BorderThickness="2" Opacity="0" />
            <Border x:Name="SelectionBorder" IsHitTestVisible="False"
                    BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="2" Opacity="0" />
            <Rectangle x:Name="TopLeftHandle" Fill="{ThemeResource SystemAccentColor}" />
            <Rectangle x:Name="TopRightHandle" Fill="{ThemeResource SystemAccentColor}" />
            <Rectangle x:Name="BottomLeftHandle" Fill="{ThemeResource SystemAccentColor}" />
            <Rectangle x:Name="BottomRightHandle" Fill="{ThemeResource SystemAccentColor}" />
            <Rectangle x:Name="TopHandle" Fill="{ThemeResource SystemAccentColor}" />
            <Rectangle x:Name="BottomHandle" Fill="{ThemeResource SystemAccentColor}" />
            <Rectangle x:Name="LeftHandle" Fill="{ThemeResource SystemAccentColor}" />
            <Rectangle x:Name="RightHandle" Fill="{ThemeResource SystemAccentColor}" />
            <Line x:Name="RotationHandleLine" IsHitTestVisible="False"
                  Stroke="{ThemeResource SystemAccentColor}" StrokeThickness="2" />
            <Ellipse x:Name="RotationHandle" Width="16" Height="16" Fill="{ThemeResource SystemAccentColor}" />
            <Border x:Name="LockBadge" Visibility="Collapsed" IsHitTestVisible="False" Background="{ThemeResource SystemAccentColor}"
                    CornerRadius="3" Padding="3">
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="White" />
            </Border>
        </Canvas>

        <Canvas
            x:Name="CropCanvas"
            Background="Transparent"
            PointerMoved="CropCanvas_PointerMoved"
            PointerPressed="CropCanvas_PointerPressed"
            PointerReleased="CropCanvas_PointerReleased"
            Visibility="Collapsed">
            <!--  Overlay rectangles removed - using CropShade rectangles instead  -->

            <!--  Crop selection rectangle  -->
            <Rectangle
                x:Name="CropRect"
                Fill="Transparent"
                Stroke="{ThemeResource SystemAccentColor}"
                StrokeThickness="2" />

            <!--  Resize Handles  -->
            <Rectangle x:Name="CropHandleTL" Style="{StaticResource CropHandleStyle}" />
            <Rectangle x:Name="CropHandleT" Style="{StaticResource CropHandleStyle}" />
            <Rectangle x:Name="CropHandleTR" Style="{StaticResource CropHandleStyle}" />
            <Rectangle x:Name="CropHandleL" Style="{StaticResource CropHandleStyle}" />
            <Rectangle x:Name="CropHandleR" Style="{StaticResource CropHandleStyle}" />
            <Rectangle x:Name="CropHandleBL" Style="{StaticResource CropHandleStyle}" />
            <Rectangle x:Name="CropHandleB" Style="{StaticResource CropHandleStyle}" />
            <Rectangle x:Name="CropHandleBR" Style="{StaticResource CropHandleStyle}" />

            <!--  Crop Rotation Handle  -->
            <Line
                x:Name="CropRotationHandleLine"
                IsHitTestVisible="False"
                Stroke="{ThemeResource SystemAccentColor}"
                StrokeThickness="2" />
            <Ellipse
                x:Name="CropRotationHandle"
                Width="16"
                Height="16"
                Fill="{ThemeResource SystemAccentColor}" />

            <!--  Accept/Cancel Buttons  -->
            <StackPanel
                x:Name="CropActionsPanel"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Orientation="Horizontal"
                Padding="4"
                SizeChanged="CropActionsPanel_SizeChanged"
                Spacing="4">
                <Button x:Name="ResetCropButton" Click="ResetCropButton_Click" ToolTipService.ToolTip="Reset Crop"
                        AutomationProperties.Name="Reset crop" Style="{StaticResource DefaultButtonStyle}">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE777;" />
                </Button>
                <Button
                    x:Name="AcceptCropButton"
                    AutomationProperties.Name="Accept crop"
                    Click="AcceptCropButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Accept Crop">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8FB;" />
                </Button>
                <Button
                    x:Name="CancelCropButton"
                    AutomationProperties.Name="Cancel crop"
                    Click="CancelCropButton_Click"
                    Style="{StaticResource DefaultButtonStyle}"
                    ToolTipService.ToolTip="Cancel Crop">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Canvas>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="HoverBorder"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.1" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Selected">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="SelectionBorder"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.1" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
