<UserControl
    x:Class="Better_SignalRGB_Screen_Capture.Views.DiagnosticsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="480" MaxWidth="520" Spacing="10">
        <TextBlock Text="Capture and SignalRGB diagnostics" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Recent frame rates update once per second. Counters remain available while paused."
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="ConnectionText" TextWrapping="Wrap" />
        <TextBlock x:Name="TransportText" TextWrapping="Wrap" />
        <TextBlock x:Name="TransportErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBlock x:Name="EmptyText" Text="Start recording to see per-source diagnostics." TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SourcesPanel" Spacing="12" />
        </ScrollViewer>
        <TextBlock Text="Dropped = waiting frames replaced by newer frames. Skipped = busy or empty website captures. Hardware is the requested native recorder mode; JPEG conversion runs on the CPU."
                   FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="HDR → SDR means the capture backend converted HDR before JPEG encoding. GDI Wallpaper Engine capture cannot preserve HDR highlights; changing halo brightness cannot recover clipped detail."
                   FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
