<UserControl
    x:Class="Better_SignalRGB_Screen_Capture.Views.SceneLibraryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button Content="Scenes" ToolTipService.ToolTip="Save and load sources and layout">
        <Button.Flyout>
            <Flyout>
                <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="360" Spacing="12">
                        <TextBlock Text="Scenes" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Save sources and layout, including layers, crop and locks. Effect settings and frame rates stay global."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox Header="Saved scene" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.SceneProfiles}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{x:Bind ViewModel.SelectedScene, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanManageScenes, Mode=OneWay}" />
                        <TextBox Header="Scene name" MaxLength="64"
                                 Text="{x:Bind ViewModel.SceneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanManageScenes, Mode=OneWay}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Save as new" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SaveNewSceneCommand}" />
                            <Button Grid.Column="1" Content="Replace saved scene" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ReplaceSceneCommand}" />
                        </Grid>
                        <Button Content="Load selected scene" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.LoadSceneCommand}" />
                        <TextBlock Text="Loading can be undone with Ctrl+Z. Missing devices remain configured so you can reconnect them or edit the source."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Rename" Command="{x:Bind ViewModel.RenameSceneCommand}" />
                            <Button Content="Delete…" IsEnabled="{x:Bind ViewModel.CanUseSelectedScene, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel MaxWidth="260" Spacing="10">
                                            <TextBlock Text="Delete this saved scene? The current canvas will stay as it is." TextWrapping="Wrap" />
                                            <Button Content="Delete saved scene" Command="{x:Bind ViewModel.DeleteSceneCommand}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Import JSON…" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ImportSceneCommand}" />
                            <Button Grid.Column="1" Content="Export JSON…" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ExportSceneCommand}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.SceneStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Button Content="Retry loading library" Command="{x:Bind ViewModel.LoadSceneLibraryCommand}" HorizontalAlignment="Left" />
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsSceneBusy, Mode=OneWay}" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
