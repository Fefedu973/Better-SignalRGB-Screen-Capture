<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platform>x64</Platform><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI><EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250610002-experimental3" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="ScreenRecorderLib" Version="6.5.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0-preview.5.25277.114" />
    <ProjectReference Include="../../Better-SignalRGB-Screen-Capture.Core/Better-SignalRGB-Screen-Capture.Core.csproj" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Services/GraphicsFrameCapture.cs" Link="GraphicsFrameCapture.cs" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Contracts/Services/IGraphicsCaptureFactory.cs" Link="IGraphicsCaptureFactory.cs" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Models/PipelineDiagnosticsSnapshot.cs" Link="PipelineDiagnosticsSnapshot.cs" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Models/SourceItem.cs" Link="SourceItem.cs" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Helpers/DisplayColorInfo.cs" Link="DisplayColorInfo.cs" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Helpers/CaptureSourceFactory.cs" Link="CaptureSourceFactory.cs" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Helpers/CaptureRecorderOptions.cs" Link="CaptureRecorderOptions.cs" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Helpers/CoordinateMapper.cs" Link="CoordinateMapper.cs" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Helpers/RegionPreviewCapture.cs" Link="RegionPreviewCapture.cs" />
    <Compile Include="../../Better-SignalRGB-Screen-Capture/Helpers/CaptureFrameEncoder.cs" Link="CaptureFrameEncoder.cs" />
  </ItemGroup>
</Project>
